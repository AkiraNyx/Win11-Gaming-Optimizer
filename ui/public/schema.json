{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Windows 11 游戏优化器配置 v2",
  "type": "object",
  "required": [
    "version",
    "preset",
    "categories"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "2.0"
    },
    "preset": {
      "type": "string",
      "enum": [
        "conservative",
        "balanced",
        "extreme",
        "custom"
      ]
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time"
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hasSSD": {
          "type": "boolean"
        },
        "hasHDD": {
          "type": "boolean"
        },
        "ramGB": {
          "type": "integer",
          "minimum": 1
        },
        "cpuCores": {
          "type": "integer",
          "minimum": 1
        },
        "cpuName": {
          "type": "string"
        },
        "gpuName": {
          "type": "string"
        },
        "gpuBrand": {
          "type": "string",
          "enum": [
            "NVIDIA",
            "AMD",
            "Intel",
            "Unknown"
          ]
        }
      }
    },
    "categories": {
      "type": "object",
      "required": [
        "windowsUpdate",
        "bootOptimization",
        "taskScheduling",
        "serviceOptimization",
        "powerManagement",
        "storageOptimization",
        "ssdOptimization",
        "memoryOptimization",
        "cpuOptimization",
        "gpuOptimization",
        "networkOptimization",
        "uiOptimization",
        "privacyOptimization",
        "securityOptimization"
      ],
      "additionalProperties": false,
      "properties": {
        "windowsUpdate": {
          "type": "object",
          "required": [
            "items"
          ],
          "additionalProperties": false,
          "properties": {
            "items": {
              "type": "object",
              "required": [
                "disableP2P",
                "deferQualityUpdates",
                "deferFeatureUpdates",
                "disableAutoDriverUpdate",
                "disableAutoUpdate"
              ],
              "additionalProperties": false,
              "properties": {
                "disableP2P": {
                  "type": "object",
                  "required": [
                    "target"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "target": {
                      "type": "boolean"
                    }
                  }
                },
                "deferQualityUpdates": {
                  "type": "object",
                  "required": [
                    "target"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "target": {
                      "oneOf": [
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 365
                        },
                        {
                          "const": "systemDefault"
                        }
                      ]
                    }
                  }
                },
                "deferFeatureUpdates": {
                  "type": "object",
                  "required": [
                    "target"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "target": {
                      "oneOf": [
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 3650
                        },
                        {
                          "const": "systemDefault"
                        }
                      ]
                    }
                  }
                },
                "disableAutoDriverUpdate": {
                  "type": "object",
                  "required": [
                    "target"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "target": {
                      "type": "boolean"
                    }
                  }
                },
                "disableAutoUpdate": {
                  "type": "object",
                  "required": [
                    "target"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "target": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        },
        "bootOptimization": {
          "type": "object",
          "required": [
            "items"
          ],
          "additionalProperties": false,
          "properties": {
            "items": {
              "type": "object",
              "required": [
                "fastStartup",
                "disableBootLog",
                "reduceBootTimeout",
                "disableStartupSound",
                "bootProcessorsFull"
              ],
              "additionalProperties": false,
              "properties": {
                "fastStartup": {
                  "type": "object",
                  "required": [
                    "target"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "target": {
                      "type": "boolean"
                    }
                  }
                },
                "disableBootLog": {
                  "type": "object",
                  "required": [
                    "target"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "target": {
                      "type": "boolean"
                    }
                  }
                },
                "reduceBootTimeout": {
                  "type": "object",
                  "required": [
                    "target"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "target": {
                      "oneOf": [
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 999
                        },
                        {
                          "const": "systemDefault"
                        }
                      ]
                    }
                  }
                },
                "disableStartupSound": {
                  "type": "object",
                  "required": [
                    "target"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "target": {
                      "type": "boolean"
                    }
                  }
                },
                "bootProcessorsFull": {
                  "type": "object",
                  "required": [
                    "execute"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "execute": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        },
        "taskScheduling": {
          "type": "object",
          "required": [
            "items"
          ],
          "additionalProperties": false,
          "properties": {
            "items": {
              "type": "object",
              "required": [
                "enableGameMode",
                "foregroundPriority",
                "disableBackgroundApps",
                "disableGameDVR"
              ],
              "additionalProperties": false,
              "properties": {
                "enableGameMode": {
                  "type": "object",
                  "required": [
                    "target"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "target": {
                      "type": "boolean"
                    }
                  }
                },
                "foregroundPriority": {
                  "type": "object",
                  "required": [
                    "target"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "target": {
                      "oneOf": [
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 63
                        },
                        {
                          "const": "systemDefault"
                        }
                      ]
                    }
                  }
                },
                "disableBackgroundApps": {
                  "type": "object",
                  "required": [
                    "target"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "target": {
                      "enum": [
                        "userControl",
                        "forceAllow",
                        "forceDeny"
                      ]
                    }
                  }
                },
                "disableGameDVR": {
                  "type": "object",
                  "required": [
                    "target"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "target": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        },
