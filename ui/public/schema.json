        "powerManagement": {
          "type": "object",
          "required": [
            "items"
          ],
          "additionalProperties": false,
          "properties": {
            "items": {
              "type": "object",
              "required": [
                "ultimatePerformancePlan",
                "minProcessorState100",
                "disablePowerThrottling",
                "disableUsbSuspend",
                "disablePcieLpm",
                "disableDiskAutoOff",
                "aggressiveBoost"
              ],
              "additionalProperties": false,
              "properties": {
                "ultimatePerformancePlan": {
                  "type": "object",
                  "required": [
                    "target"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "target": {
                      "oneOf": [
                        {
                          "type": "string",
                          "enum": [
                            "balanced",
                            "ultimatePerformance"
                          ]
                        },
                        {
                          "type": "string",
                          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                        }
                      ]
                    }
                  }
                },
                "minProcessorState100": {
                  "type": "object",
                  "required": [
                    "target"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "target": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 100
                    }
                  }
                },
                "disablePowerThrottling": {
                  "type": "object",
                  "required": [
                    "target"
                  ],
                  "additionalProperties": false,
                  "properties": {
