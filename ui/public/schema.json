                  ],
                  "additionalProperties": false,
                  "properties": {
                    "target": {
                      "enum": [
                        0,
                        1,
                        2
                      ]
                    }
                  }
                },
                "disableDiskAutoOff": {
                  "type": "object",
                  "required": [
                    "target"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "target": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 86400
                    }
                  }
                },
                "aggressiveBoost": {
                  "type": "object",
                  "required": [
                    "target"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "target": {
                      "enum": [
                        0,
                        1,
                        2,
                        3,
                        4
                      ]
                    }
                  }
                }
              }
            }
