{
  "name": "win11-gaming-optimizer",
  "version": "0.0.2",
  "description": "Windows 11 gaming optimization control panel",
  "author": {
    "name": "AkiraNyx"
  },
  "license": "AGPL-3.0-only",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "node server.js",
    "electron": "electron electron/main.cjs",
    "package": "electron-builder --win portable --x64",
    "lint": "eslint .",
    "test": "npm run test:dependencies && npm run test:presets && npm run test:server && npm run test:electron",
    "test:dependencies": "node --experimental-strip-types --test config-dependencies.test.ts",
    "test:presets": "node --experimental-strip-types --test presets.test.ts",
    "test:server": "node --test server.test.js",
    "test:electron": "node --test electron/startup.test.cjs"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "geist": "^1.7.2",
    "lucide-react": "^1.28.0",
    "motion": "^12.43.0",
    "next": "^16.2.12",
    "postcss": "^8.5.25",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.16.1",
    "tailwindcss": "^4.3.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "postcss": "$postcss",
    "next": {
      "sharp": "0.35.3"
    }
  },
  "build": {
    "appId": "com.win11optimizer.app",
    "productName": "Win11 Optimizer",
    "copyright": "AkiraNyx",
    "asar": true,
    "electronDownload": {
      "cache": "node_modules/.cache/electron"
    },
    "directories": {
      "output": "../build-electron",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "out/**/*",
      "config-validator.js",
      "server.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../scripts",
        "to": "scripts",
        "filter": [
          "**/*.ps1",
          "**/*.psm1"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Win11Optimizer.exe",
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "portable": {
      "artifactName": "Win11Optimizer.exe",
      "requestExecutionLevel": "admin"
    }
  }
}
