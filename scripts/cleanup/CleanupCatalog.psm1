#Requires -Version 5.1

<#
Cleanup target catalog.

Every deletable location is declared here, statically. The HTTP layer only ever
passes a target id, never a raw path, so a compromised or buggy client cannot
turn the cleanup endpoint into an arbitrary delete primitive.

Kinds
  contents  - delete the entries inside each matching directory, keep the directory
  files     - delete only files matching Pattern inside each matching directory
  recyclebin- empty the recycle bin through the shell API
  report    - measure only; never deleted (surfaces advice instead)

Risk
  safe      - regenerated by Windows or the owning app, no functional loss
  medium    - re-downloaded or rebuilt on demand, temporary slowdown
  caution   - user-visible loss (saved downloads, offline assets)
  report    - read-only inventory
#>

function New-CleanupTarget {
    param(
        [Parameter(Mandatory = $true)][string]$Id,
        [Parameter(Mandatory = $true)][string]$Group,
        [Parameter(Mandatory = $true)][string]$Label,
        [Parameter(Mandatory = $true)][string]$Description,
        [Parameter(Mandatory = $true)][ValidateSet("safe", "medium", "caution", "report")][string]$Risk,
        [Parameter(Mandatory = $true)][ValidateSet("contents", "files", "recyclebin", "report")][string]$Kind,
        [string[]]$Paths = @(),
        [string]$Pattern = "*",
        [int]$OlderThanDays = -1,
        [bool]$RequiresAdmin = $false,
        [string]$Note = ""
    )

    [pscustomobject]@{
        Id             = $Id
        Group          = $Group
        Label          = $Label
        Description    = $Description
        Risk           = $Risk
        Kind           = $Kind
        Paths          = @($Paths)
        Pattern        = $Pattern
        OlderThanDays  = $OlderThanDays
        RequiresAdmin  = $RequiresAdmin
        Note           = $Note
        DefaultSelected = ($Risk -eq "safe")
    }
}

function Get-CleanupGroupCatalog {
    @(
        [pscustomobject]@{ Id = "windows-update"; Label = "Windows 更新与日志"; Description = "已安装更新的下载缓存、更新编排器日志、组件安装日志"; Icon = "Download" }
        [pscustomobject]@{ Id = "system-temp";    Label = "系统临时文件";     Description = "系统临时目录、错误报告、蓝屏转储";                   Icon = "Trash2" }
        [pscustomobject]@{ Id = "app-updaters";   Label = "软件更新包";       Description = "Squirrel/Electron 更新器留下的待安装包与安装器副本"; Icon = "PackageOpen" }
        [pscustomobject]@{ Id = "dev-caches";     Label = "开发工具缓存";     Description = "pip / npm / pnpm / Playwright / Arduino 的下载缓存"; Icon = "Boxes" }
        [pscustomobject]@{ Id = "browser-cache";  Label = "浏览器与着色器";   Description = "浏览器页面缓存、缩略图缓存、显卡着色器缓存";         Icon = "Globe" }
        [pscustomobject]@{ Id = "user-files";     Label = "回收站与安装包";   Description = "回收站内容与 Downloads 中重复的大安装包（仅报告）"; Icon = "FolderDown" }
        [pscustomobject]@{ Id = "inventory";      Label = "只读盘点";         Description = "组件存储与驱动仓库占用，给出官方清理建议";           Icon = "Info" }
    )
}

function Get-CleanupCatalog {
    # The host launches PowerShell with a minimal environment (buildChildEnvironment
    # in ui/server.js keeps only SystemRoot, WINDIR, PATH...), so TEMP and ProgramData
    # are not guaranteed to exist. Resolve every root through .NET instead.
    $localAppData = [Environment]::GetFolderPath("LocalApplicationData")
    $userProfile  = [Environment]::GetFolderPath("UserProfile")
    $programData  = [Environment]::GetFolderPath("CommonApplicationData")
    $windir       = [Environment]::GetEnvironmentVariable("windir")
    if (-not $windir) { $windir = [Environment]::GetFolderPath("Windows") }
    $tempRoot     = [Environment]::GetEnvironmentVariable("TEMP")
    if (-not $tempRoot) { $tempRoot = Join-Path $localAppData "Temp" }

    @(
        # ---------------- Windows Update ----------------
        (New-CleanupTarget -Id "wu-download" -Group "windows-update" `
            -Label "Windows 更新下载缓存" `
            -Description "Windows Update 已下载并安装完成的补丁包，可安全删除" `
            -Risk safe -Kind contents -RequiresAdmin $true `
            -Paths @((Join-Path $windir "SoftwareDistribution\Download")) `
            -Note "删除后不影响已安装的更新；下次更新会自动重建该目录")

        (New-CleanupTarget -Id "wu-logs" -Group "windows-update" `
            -Label "Windows 更新日志" `
            -Description "WindowsUpdate.log 等更新诊断日志" `
            -Risk safe -Kind contents -RequiresAdmin $true `
            -Paths @((Join-Path $windir "Logs\WindowsUpdate")))

        (New-CleanupTarget -Id "cbs-logs" -Group "windows-update" `
            -Label "组件安装日志 (CBS/DISM)" `
            -Description "CBS.log、DISM.log 等组件安装日志，更新后常膨胀到数百 MB" `
            -Risk safe -Kind contents -RequiresAdmin $true `
            -Paths @((Join-Path $windir "Logs\CBS"), (Join-Path $windir "Logs\DISM")))

        (New-CleanupTarget -Id "uso-shared" -Group "windows-update" `
            -Label "更新编排器日志" `
            -Description "USO 更新编排器的运行日志" `
            -Risk safe -Kind contents -RequiresAdmin $true `
            -Paths @((Join-Path $programData "USOShared\Logs")))

        (New-CleanupTarget -Id "panther-logs" -Group "windows-update" `
            -Label "安装阶段日志" `
            -Description "Windows 安装与升级阶段的 Panther 日志" `
            -Risk safe -Kind contents -RequiresAdmin $true `
            -Paths @((Join-Path $windir "Panther")))

        # ---------------- System temp ----------------
        (New-CleanupTarget -Id "windows-temp" -Group "system-temp" `
            -Label "系统临时目录" `
            -Description "C:\Windows\Temp 下一天前的临时文件" `
            -Risk safe -Kind contents -RequiresAdmin $true -OlderThanDays 1 `
            -Paths @((Join-Path $windir "Temp")))

        (New-CleanupTarget -Id "user-temp" -Group "system-temp" `
            -Label "用户临时目录" `
            -Description "当前用户 %TEMP% 下一天前的临时文件与解压残留" `
            -Risk safe -Kind contents -OlderThanDays 1 `
            -Paths @($tempRoot))

        (New-CleanupTarget -Id "wer-reports" -Group "system-temp" `
            -Label "错误报告队列" `
            -Description "Windows 错误报告的归档与待发送队列" `
            -Risk safe -Kind contents -RequiresAdmin $true `
            -Paths @((Join-Path $programData "Microsoft\Windows\WER\ReportArchive"),
                     (Join-Path $programData "Microsoft\Windows\WER\ReportQueue")))

        (New-CleanupTarget -Id "crash-dumps" -Group "system-temp" `
            -Label "蓝屏转储" `
            -Description "Minidump 与 LiveKernelReports 中的崩溃转储文件" `
            -Risk safe -Kind contents -RequiresAdmin $true `
            -Paths @((Join-Path $windir "Minidump"), (Join-Path $windir "LiveKernelReports")))

        # ---------------- Third-party updaters ----------------
        (New-CleanupTarget -Id "squirrel-pending" -Group "app-updaters" `
            -Label "待安装更新包 (pending)" `
            -Description "Squirrel 更新器下载后未清理的待安装包，通常与安装器副本重复" `
            -Risk safe -Kind contents -OlderThanDays 0 `
            -Paths @((Join-Path $localAppData "*-updater\pending")) `
            -Note "删除后放弃已下载但未应用的更新，应用下次启动会重新检查")

        (New-CleanupTarget -Id "squirrel-installer" -Group "app-updaters" `
            -Label "更新器安装器副本" `
            -Description "*-updater\installer.exe，与应用版本一同缓存的安装器副本" `
            -Risk safe -Kind files -Pattern "installer.exe" -OlderThanDays 0 `
            -Paths @((Join-Path $localAppData "*-updater")))

        (New-CleanupTarget -Id "squirrel-temp" -Group "app-updaters" `
            -Label "Squirrel 解压临时目录" `
            -Description "更新器解压过程中的临时目录，成功后通常不清理" `
            -Risk safe -Kind contents -OlderThanDays 0 `
            -Paths @((Join-Path $localAppData "SquirrelTemp")))

        (New-CleanupTarget -Id "winget-download" -Group "app-updaters" `
            -Label "winget 下载缓存" `
            -Description "winget 安装过程中的下载缓存" `
            -Risk safe -Kind contents -OlderThanDays 0 `
            -Paths @((Join-Path $tempRoot "WinGet")))

        # ---------------- Dev caches ----------------
        (New-CleanupTarget -Id "pip-cache" -Group "dev-caches" `
            -Label "pip 下载缓存" `
            -Description "Python 包 wheel 与源码下载缓存" `
            -Risk medium -Kind contents -OlderThanDays 0 `
            -Paths @((Join-Path $localAppData "pip\Cache")))

        (New-CleanupTarget -Id "npm-cache" -Group "dev-caches" `
            -Label "npm 缓存" `
            -Description "npm 包 tarball 与元数据缓存，可用 npm cache clean --force 重建" `
            -Risk medium -Kind contents -OlderThanDays 0 `
            -Paths @((Join-Path $localAppData "npm-cache")))

        (New-CleanupTarget -Id "pnpm-store" -Group "dev-caches" `
            -Label "pnpm 存储" `
            -Description "pnpm 内容寻址存储中的包文件" `
            -Risk medium -Kind contents -OlderThanDays 0 `
            -Paths @((Join-Path $localAppData "pnpm\store")))

        (New-CleanupTarget -Id "arduino-staging" -Group "dev-caches" `
            -Label "Arduino 板级包下载缓存" `
            -Description "Arduino IDE 下载并已解压到 packages 的原始 zip，删除后重装核心会重新下载" `
            -Risk medium -Kind contents -OlderThanDays 0 `
            -Paths @((Join-Path $localAppData "Arduino15\staging")))

        (New-CleanupTarget -Id "playwright-browsers" -Group "dev-caches" `
            -Label "Playwright 浏览器" `
            -Description "Playwright 下载的 Chromium/Firefox/WebKit 二进制，删除后需重新安装" `
            -Risk caution -Kind contents -OlderThanDays 0 `
            -Paths @((Join-Path $localAppData "ms-playwright")))

        # ---------------- Browser / shader caches ----------------
        (New-CleanupTarget -Id "chrome-cache" -Group "browser-cache" `
            -Label "Chrome 页面缓存" `
            -Description "Chrome 各配置文件的 Cache/Code Cache/GPUCache" `
            -Risk safe -Kind contents -OlderThanDays 0 `
            -Paths @((Join-Path $localAppData "Google\Chrome\User Data\*\Cache"),
                     (Join-Path $localAppData "Google\Chrome\User Data\*\Code Cache"),
                     (Join-Path $localAppData "Google\Chrome\User Data\*\GPUCache")))

        (New-CleanupTarget -Id "edge-cache" -Group "browser-cache" `
            -Label "Edge 页面缓存" `
            -Description "Edge 各配置文件的 Cache/Code Cache/GPUCache" `
            -Risk safe -Kind contents -OlderThanDays 0 `
            -Paths @((Join-Path $localAppData "Microsoft\Edge\User Data\*\Cache"),
                     (Join-Path $localAppData "Microsoft\Edge\User Data\*\Code Cache"),
                     (Join-Path $localAppData "Microsoft\Edge\User Data\*\GPUCache")))

        (New-CleanupTarget -Id "shader-cache" -Group "browser-cache" `
            -Label "显卡着色器缓存" `
            -Description "AMD / NVIDIA / DirectX 着色器缓存，删除后首次进入游戏会重新编译" `
            -Risk medium -Kind contents -OlderThanDays 0 `
            -Paths @((Join-Path $localAppData "AMD\DxCache"),
                     (Join-Path $localAppData "AMD\DxcCache"),
                     (Join-Path $localAppData "NVIDIA\DXCache"),
                     (Join-Path $localAppData "NVIDIA\GLCache"),
                     (Join-Path $localAppData "D3DSCache")))

        (New-CleanupTarget -Id "thumb-cache" -Group "browser-cache" `
            -Label "缩略图缓存" `
            -Description "资源管理器缩略图与图标缓存数据库" `
            -Risk safe -Kind files -Pattern "thumbcache_*.db" -OlderThanDays 0 `
            -Paths @((Join-Path $localAppData "Microsoft\Windows\Explorer")))

        # ---------------- Recycle bin / user files ----------------
        (New-CleanupTarget -Id "recycle-bin" -Group "user-files" `
            -Label "回收站" `
            -Description "清空所有本地卷回收站中的内容，不可恢复" `
            -Risk caution -Kind recyclebin -OlderThanDays 0)

        (New-CleanupTarget -Id "stale-installers" -Group "user-files" `
            -Label "Downloads 中的大安装包" `
            -Description "Downloads 下超过 100 MB 的安装包/镜像，以及与压缩包重复的解压目录（仅盘点，不删除）" `
            -Risk report -Kind report -OlderThanDays 0 `
            -Paths @((Join-Path $userProfile "Downloads")))

        # ---------------- Inventory only ----------------
        (New-CleanupTarget -Id "component-store" -Group "inventory" `
            -Label "组件存储 (WinSxS)" `
            -Description "含硬链接重复计数，实际占用请用 DISM 分析；本工具不删除" `
            -Risk report -Kind report -RequiresAdmin $true `
            -Paths @((Join-Path $windir "WinSxS")) `
            -Note "官方清理：Dism /Online /Cleanup-Image /StartComponentCleanup")

        (New-CleanupTarget -Id "driver-store" -Group "inventory" `
            -Label "驱动仓库 (DriverStore)" `
            -Description "系统保留的历史驱动版本，本工具不删除" `
            -Risk report -Kind report -RequiresAdmin $true `
            -Paths @((Join-Path $windir "System32\DriverStore")) `
            -Note "官方清理：pnputil /enum-drivers 后按 oemNN.inf 删除旧驱动")
    )
}

function Get-CleanupTargetById {
    param([Parameter(Mandatory = $true)][string[]]$Ids)

    $catalog = Get-CleanupCatalog
    $index = @{}
    foreach ($target in $catalog) { $index[$target.Id] = $target }

    $unknown = @($Ids | Where-Object { -not $index.ContainsKey($_) })
    [pscustomobject]@{
        Targets = @($Ids | Where-Object { $index.ContainsKey($_) } | ForEach-Object { $index[$_] })
        Unknown = $unknown
    }
}

Export-ModuleMember -Function Get-CleanupCatalog, Get-CleanupGroupCatalog, Get-CleanupTargetById
